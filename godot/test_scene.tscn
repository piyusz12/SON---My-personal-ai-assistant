[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://test_scene.gd" id="1_test"]
[ext_resource type="PackedScene" path="res://mini_window.tscn" id="2_mini"]

[node name="TestScene" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_test")

[node name="MiniWindow" parent="." instance=ExtResource("2_mini")]
layout_mode = 1

[node name="TestDashboard" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -210.0
offset_top = 20.0
offset_right = -20.0
offset_bottom = 440.0
grow_horizontal = 0

[node name="VBox" type="VBoxContainer" parent="TestDashboard"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="TestDashboard/VBox"]
layout_mode = 2
text = "Offline State Tester"

[node name="IdleBtn" type="Button" parent="TestDashboard/VBox"]
layout_mode = 2
text = "State: IDLE"

[node name="ListBtn" type="Button" parent="TestDashboard/VBox"]
layout_mode = 2
text = "State: LISTENING"

[node name="ThinkBtn" type="Button" parent="TestDashboard/VBox"]
layout_mode = 2
text = "State: THINKING"

[node name="SpeakBtn" type="Button" parent="TestDashboard/VBox"]
layout_mode = 2
text = "State: SPEAKING"

[node name="ExecBtn" type="Button" parent="TestDashboard/VBox"]
layout_mode = 2
text = "State: EXECUTING"

[node name="VisionBtn" type="Button" parent="TestDashboard/VBox"]
layout_mode = 2
text = "State: VISION"

[node name="WarnBtn" type="Button" parent="TestDashboard/VBox"]
layout_mode = 2
text = "State: WARNING"

[node name="ErrBtn" type="Button" parent="TestDashboard/VBox"]
layout_mode = 2
text = "State: ERROR"

[node name="AmpLabel" type="Label" parent="TestDashboard/VBox"]
layout_mode = 2
text = "Audio Amplitude:"

[node name="AmpSlider" type="HSlider" parent="TestDashboard/VBox"]
layout_mode = 2
max_value = 1.0
step = 0.05
value = 0.5

[node name="ToggleModeBtn" type="Button" parent="TestDashboard/VBox"]
layout_mode = 2
text = "Toggle Compact/Expand"

[node name="SimChatBtn" type="Button" parent="TestDashboard/VBox"]
layout_mode = 2
text = "Simulate Chat Flow"

[connection signal="pressed" from="TestDashboard/VBox/IdleBtn" to="." method="_on_idle_pressed"]
[connection signal="pressed" from="TestDashboard/VBox/ListBtn" to="." method="_on_listening_pressed"]
[connection signal="pressed" from="TestDashboard/VBox/ThinkBtn" to="." method="_on_thinking_pressed"]
[connection signal="pressed" from="TestDashboard/VBox/SpeakBtn" to="." method="_on_speaking_pressed"]
[connection signal="pressed" from="TestDashboard/VBox/ExecBtn" to="." method="_on_executing_pressed"]
[connection signal="pressed" from="TestDashboard/VBox/VisionBtn" to="." method="_on_vision_pressed"]
[connection signal="pressed" from="TestDashboard/VBox/WarnBtn" to="." method="_on_warning_pressed"]
[connection signal="pressed" from="TestDashboard/VBox/ErrBtn" to="." method="_on_error_pressed"]
[connection signal="value_changed" from="TestDashboard/VBox/AmpSlider" to="." method="_on_amp_slider_value_changed"]
[connection signal="pressed" from="TestDashboard/VBox/ToggleModeBtn" to="." method="_on_toggle_mode_pressed"]
[connection signal="pressed" from="TestDashboard/VBox/SimChatBtn" to="." method="_on_sim_chat_pressed"]
