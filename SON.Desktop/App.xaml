        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- HYPER-FUTURISTIC CYBER GLASS DESIGN SYSTEM (SON OS V3)     -->
        <!-- ══════════════════════════════════════════════════════════ -->

        <!-- Deep Cosmic Void Canvas Colors -->
        <Color x:Key="BgDarkColor">#030509</Color>
        <Color x:Key="BgSurfaceColor">#070B14BF</Color>
        <Color x:Key="BgCardColor">#0C1220CC</Color>
        <Color x:Key="BorderDarkColor">#131D33</Color>

        <!-- Futuristic Glass Translucent Acrylic Colors -->
        <Color x:Key="GlassBaseColor">#060914F0</Color>
        <Color x:Key="GlassSurfaceColor">#0A0F1EC8</Color>
        <Color x:Key="GlassCardColor">#0E162AB8</Color>
        <Color x:Key="GlassCardElevatedColor">#131E38D8</Color>
        <Color x:Key="GlassPillColor">#132038A6</Color>

        <!-- Vibrant Neon Cyber Accent Colors -->
        <Color x:Key="AccentCyanColor">#00F0FF</Color>
        <Color x:Key="AccentBlueColor">#3B82F6</Color>
        <Color x:Key="AccentIndigoColor">#6366F1</Color>
        <Color x:Key="AccentPurpleColor">#A855F7</Color>
        <Color x:Key="AccentEmeraldColor">#00F5A0</Color>
        <Color x:Key="AccentAmberColor">#FFB800</Color>
        <Color x:Key="AccentRoseColor">#FF0055</Color>

        <!-- Typography Palette -->
        <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
        <Color x:Key="TextSecondaryColor">#94A3B8</Color>
        <Color x:Key="TextMutedColor">#64748B</Color>

        <!-- Base Solid Brushes -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}" />
        <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
        <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}" />

        <!-- Apple Glass Brushes -->
        <SolidColorBrush x:Key="GlassBaseBrush" Color="{StaticResource GlassBaseColor}" />
        <SolidColorBrush x:Key="GlassSurfaceBrush" Color="{StaticResource GlassSurfaceColor}" />
        <SolidColorBrush x:Key="GlassCardBrush" Color="{StaticResource GlassCardColor}" />
        <SolidColorBrush x:Key="GlassCardElevatedBrush" Color="{StaticResource GlassCardElevatedColor}" />
        <SolidColorBrush x:Key="GlassPillBrush" Color="{StaticResource GlassPillColor}" />

        <!-- Accents -->
        <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyanColor}" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
        <SolidColorBrush x:Key="AccentIndigoBrush" Color="{StaticResource AccentIndigoColor}" />
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}" />
        <SolidColorBrush x:Key="AccentEmeraldBrush" Color="{StaticResource AccentEmeraldColor}" />
        <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}" />
        <SolidColorBrush x:Key="AccentRoseBrush" Color="{StaticResource AccentRoseColor}" />

        <!-- Typography Brushes -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

        <!-- ── Specular Futuristic Neon Gradient Borders ── -->
        <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4500F0FF" Offset="0.0" />
            <GradientStop Color="#1E8B5CF6" Offset="0.4" />
            <GradientStop Color="#0AFFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassBorderHighlightBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8500F0FF" Offset="0.0" />
            <GradientStop Color="#40A855F7" Offset="0.5" />
            <GradientStop Color="#103B82F6" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassBorderAccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B000F0FF" Offset="0.0" />
            <GradientStop Color="#70A855F7" Offset="0.5" />
            <GradientStop Color="#302563EB" Offset="1.0" />
        </LinearGradientBrush>

        <!-- ── Ambient Cyber Mesh Gradients for Backgrounds ── -->
        <RadialGradientBrush x:Key="AmbientGlowBrush" Center="0.15,0.08" GradientOrigin="0.15,0.08" RadiusX="0.6" RadiusY="0.6">
            <GradientStop Color="#2500F0FF" Offset="0.0" />
            <GradientStop Color="#0F06B6D4" Offset="0.45" />
            <GradientStop Color="#00030509" Offset="1.0" />
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="EmeraldGlowBrush" Center="0.85,0.92" GradientOrigin="0.85,0.92" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#25A855F7" Offset="0.0" />
            <GradientStop Color="#0A3B82F6" Offset="0.5" />
            <GradientStop Color="#00030509" Offset="1.0" />
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="AppleUserBubbleBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E40AF" Offset="0.0" />
            <GradientStop Color="#4F46E5" Offset="0.55" />
            <GradientStop Color="#7C3AED" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ApplePrimaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00F0FF" Offset="0.0" />
            <GradientStop Color="#0284C7" Offset="1.0" />
        </LinearGradientBrush>

        <!-- ── Typography Defaults ── -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, SF Pro Display, Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- ── Apple Glass Card Container Style ── -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.32" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassPill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassPillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>

        <!-- ── Apple Glass Input Box ── -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#121826B3" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentCyanBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource AccentCyanBrush}" />
                                <Setter Property="Background" TargetName="border" Value="#162032CC" />
                                <Setter Property="Effect" TargetName="border">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#00F0FF" Opacity="0.45" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary Button (Apple Capsule / Rounded Squircle) ── -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ApplePrimaryButtonBrush}" />
            <Setter Property="Foreground" Value="#020B14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.9" />
                                <Setter Property="Effect" TargetName="border">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#00F0FF" Opacity="0.55" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.75" />
                                <Setter Property="RenderTransform" TargetName="border">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" CenterX="50" CenterY="20" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary Apple Glass Button ── -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#18233699" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#22314CCC" />
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource GlassBorderHighlightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#1A2538B3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Danger Apple Glass Button ── -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#E11D48E6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.9" />
                                <Setter Property="Effect" TargetName="border">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#E11D48" Opacity="0.5" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Apple Pill Send Button ── -->
        <Style x:Key="AppleSendButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ApplePrimaryButtonBrush}" />
            <Setter Property="Foreground" Value="#020B14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.92" />
                                <Setter Property="Effect" TargetName="border">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#00F0FF" Opacity="0.6" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Sidebar Apple Nav Item ── -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="navBorder" Value="#1C263B80" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="navBorder" Value="#25345099" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ListBoxItem Apple Style ── -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" TargetName="itemBorder" Value="#1E2A40B3" />
                                <Setter Property="BorderBrush" TargetName="itemBorder" Value="{StaticResource GlassBorderBrush}" />
                                <Setter Property="BorderThickness" TargetName="itemBorder" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="itemBorder" Value="#16203280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox Apple Dark Glass ── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#121826B3" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <!-- ── Apple Sleek Floating ScrollBar ── -->
        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#40FFFFFF"
                                CornerRadius="3"
                                Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#70FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background" Value="#90FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6" />
                    <Setter Property="Width" Value="Auto" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
