<Application x:Class="SON.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SON.Desktop.Converters"
             xmlns:views="clr-namespace:SON.Desktop.Views"
             xmlns:vms="clr-namespace:SON.Desktop.ViewModels">
    <Application.Resources>
        <!-- Converters -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:NotNullToBoolConverter x:Key="NotNullToBool" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NotNullToVisibility" Invert="True" />
        <converters:PageToNavBackgroundConverter x:Key="PageToNavBg" />
        <converters:PageToNavForegroundConverter x:Key="PageToNavFg" />
        <converters:PageToIndicatorVisibilityConverter x:Key="PageToIndicator" />
        <converters:RiskToColorConverter x:Key="RiskToColor" />
        <converters:ConnectionStatusToBrushConverter x:Key="ConnectionToBrush" />
        <converters:AuditEventColorConverter x:Key="AuditEventColor" />
        <converters:ValueToPercentageBrushConverter x:Key="ValueToPercentageBrush" />
        <converters:EqualityToBoolConverter x:Key="EqualityToBoolConverter" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
        <converters:CountToVisibilityConverter x:Key="InverseCountToVisibility" Invert="True" />
        <converters:BoolToSidebarWidthConverter x:Key="BoolToSidebarWidth" />
        <converters:ResourceKeyToGeometryConverter x:Key="ResourceKeyToGeometry" />

        <!-- View DataTemplates for ViewModel Navigation -->
        <DataTemplate DataType="{x:Type vms:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:ChatViewModel}">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:VoiceViewModel}">
            <views:VoiceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:MemoryViewModel}">
            <views:MemoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:VisionViewModel}">
            <views:VisionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:AutomationViewModel}">
            <views:AutomationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:FilesViewModel}">
            <views:FilesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:CodeViewModel}">
            <views:CodeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:TasksViewModel}">
            <views:TasksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:SecurityViewModel}">
            <views:SecurityView />
        </DataTemplate>

