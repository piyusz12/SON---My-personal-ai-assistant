<UserControl x:Class="SON.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- HEADER (APPLE GLASS CARD)                                  -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource GlassCard}"
                    Padding="28,24"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="System Settings &amp; Preferences" FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="Configure local runtime, IPC named pipe endpoints, Apple glass appearance, and hardware preferences."
                               FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- CONFIGURATION TILES (APPLE GLASS TILES)                    -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0">
                    <!-- Theme & UI Appearance Card -->
                    <Border Style="{StaticResource GlassCard}"
                            Padding="22"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE &amp; THEME" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />
                            <TextBlock Text="Color Theme:" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      Margin="0,0,0,16" />
                            <TextBlock Text="Apple Liquid Glass aesthetic applied across all 11 desktop workspaces."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- IPC & Backend Connection Card -->
                    <Border Style="{StaticResource GlassCard}"
                            Padding="22"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="BACKEND &amp; IPC CONFIGURATION" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />
                            <TextBlock Text="Windows Named Pipe Endpoint:" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding IpcPipeName}" IsReadOnly="True" Margin="0,0,0,12" />

                            <TextBlock Text="Ollama API Host:" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding OllamaHost}" Margin="0,0,0,14" />

                            <Button Command="{Binding TestConnectionCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Test IPC Connection"
                                    Padding="14,8"
                                    Margin="0,0,0,12" />

                            <Border Background="#121826CC" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <TextBlock Text="{Binding BackendStatus}"
                                           FontSize="12"
                                           Foreground="{StaticResource AccentCyanBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="2">
                    <!-- Model Selection Card -->
                    <Border Style="{StaticResource GlassCard}"
                            Padding="22"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="LOCAL MODEL RUNTIME" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />
                            <TextBlock Text="Default Conversation Model:" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedModel}"
                                      Margin="0,0,0,16" />
                            <TextBlock Text="Models execute locally on your NVIDIA GeForce RTX 4060 GPU with VRAM telemetry."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- About SON Desktop (Apple System Info Style) -->
                    <Border Style="{StaticResource GlassCard}"
                            Padding="22"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="ABOUT SON DESKTOP" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border CornerRadius="10"
                                        Width="36" Height="36"
                                        Margin="0,0,10,0"
                                        BorderBrush="{StaticResource GlassBorderAccentBrush}"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <ImageBrush ImageSource="/Resources/son_icon.jpg" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="SON Desktop (Smart Operating Node)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding AppVersion}" FontSize="11.5" Foreground="{StaticResource AccentCyanBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Hardware Environment:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding HardwareSpecs}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock Text="Architecture: C# WPF .NET 8 LTS + Apple Liquid Glass Aesthetic + Python PydanticAI Backend + Zero-Trust PolicyEngine + Kernel Isolated Named Pipe IPC."
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
