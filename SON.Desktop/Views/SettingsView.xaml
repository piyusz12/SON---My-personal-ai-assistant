<UserControl x:Class="SON.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            <!-- Header -->
            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28,24"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="System Settings &amp; Configuration" FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="Configure local runtime, IPC endpoints, themes, and hardware preferences."
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Configuration Panels -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0">
                    <!-- Theme & UI -->
                    <Border Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE &amp; THEME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />
                            <TextBlock Text="Color Theme:" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      Background="#161B26"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Padding="10,8"
                                      Margin="0,0,0,16" />
                            <TextBlock Text="Theme applied across all 6 desktop views and HUD overlays."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- IPC & Backend Connection -->
                    <Border Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="BACKEND &amp; IPC CONFIGURATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />
                            <TextBlock Text="Windows Named Pipe Name:" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding IpcPipeName}" IsReadOnly="True" Margin="0,0,0,12" />
                            <TextBlock Text="Ollama API Host:" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding OllamaHost}" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding BackendStatus, StringFormat='Backend Pipe Status: {0}'}"
                                       FontSize="12" Foreground="{StaticResource AccentEmeraldBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="2">
                    <!-- Model Selection -->
                    <Border Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="MODEL SELECTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />
                            <TextBlock Text="Default Conversation Model:" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedModel}"
                                      Background="#161B26"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Padding="10,8"
                                      Margin="0,0,0,16" />
                            <TextBlock Text="Models execute locally on your NVIDIA GeForce RTX 4060 GPU."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- About SON Desktop -->
                    <Border Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="ABOUT SON DESKTOP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />
                            <TextBlock Text="SON Desktop (Smart Operating Node)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding AppVersion}" FontSize="12" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="Hardware Environment:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding HardwareSpecs}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock Text="Architecture: C# WPF .NET 8 LTS + Python PydanticAI Backend + Zero-Trust PolicyEngine + Kernel Isolated Named Pipe IPC."
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

