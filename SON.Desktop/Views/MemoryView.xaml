<UserControl x:Class="SON.Desktop.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:SON.Desktop.Models"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <Grid Background="{StaticResource BgDarkBrush}" Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28,24"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Structured Memory &amp; Facts" FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="Persistent L2 SQLite knowledge store. Facts recalled automatically during relevant prompts."
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding LoadFactsCommand}" Style="{StaticResource SecondaryButton}" Content="🔄 Refresh Facts" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Search & Filter Bar -->
        <Border Grid.Row="1"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="14"
                         VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Body: Facts List & Detail / Add Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Facts List -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="PERSISTENT FACTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Facts}"
                             SelectedItem="{Binding SelectedFact, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:MemoryFactItem}">
                                <Border Background="#161B26"
                                        BorderBrush="{StaticResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Fact}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource AccentBlueBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding CreatedAt}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Add & Detail Panel -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="ADD PERSISTENT FACT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" />

                    <TextBlock Text="Fact Description:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding NewFactText, UpdateSourceTrigger=PropertyChanged}"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Category:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding NewFactCategory, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" />

                    <Button Command="{Binding AddFactCommand}"
                            Content="➕ Store in Memory"
                            Padding="0,10"
                            Margin="0,0,0,24" />

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,20" />

                    <TextBlock Text="MANAGE SELECTED FACT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />
                    <Button Command="{Binding DeleteSelectedFactCommand}"
                            Style="{StaticResource DangerButton}"
                            Content="🗑 Delete Fact"
                            Padding="0,10"
                            IsEnabled="{Binding SelectedFact, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Message -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="4,12,0,0" />
    </Grid>
</UserControl>

