<UserControl x:Class="SON.Desktop.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:SON.Desktop.Models"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <Grid Background="{StaticResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Controls -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💬" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="AI Conversation" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="— Routed via Central Orchestrator &amp; PolicyEngine"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding StopGenerationCommand}"
                            Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource DangerButton}"
                            Content="⏹ Stop"
                            Padding="12,6"
                            Margin="0,0,8,0" />
                    <Button Command="{Binding ClearChatCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Content="🗑 Clear Chat"
                            Padding="12,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Messages Scroll Area -->
        <ScrollViewer Grid.Row="1"
                      x:Name="MessagesScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,16">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ChatMessage}">
                        <Grid Margin="0,10">
                            <!-- User Message (Right Aligned) -->
                            <Border HorizontalAlignment="Right"
                                    MaxWidth="720"
                                    Background="#1E293B"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="14,14,2,14"
                                    Padding="18,14"
                                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding FormattedTime}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Right"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Assistant Message (Left Aligned) -->
                            <Border HorizontalAlignment="Left"
                                    MaxWidth="780"
                                    Background="{StaticResource BgSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14,14,14,2"
                                    Padding="20,16"
                                    Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <!-- Assistant Header with Badge, Timestamp & Copy Button -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{StaticResource AccentEmeraldBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="SON AI" FontSize="11" FontWeight="Bold" Foreground="#0A0C10" />
                                            </Border>
                                            <TextBlock Text="{Binding FormattedTime}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Copy to Clipboard Button -->
                                        <Button Grid.Column="2"
                                                Command="{Binding DataContext.CopyMessageTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Text}"
                                                ToolTip="Copy response to clipboard"
                                                Background="Transparent"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Padding="6,2"
                                                FontSize="11"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📋" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Copy" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Loading indicator -->
                                    <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                                Orientation="Horizontal" Margin="0,8">
                                        <ProgressBar IsIndeterminate="True" Width="130" Height="4"
                                                     Foreground="{StaticResource AccentEmeraldBrush}"
                                                     Background="#1A1F2C" BorderThickness="0" Margin="0,0,12,0" />
                                        <TextBlock Text="Reasoning through PydanticAI defensive agent..."
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" />
                                    </StackPanel>

                                    <!-- Assistant Body (Selectable text) -->
                                    <TextBox Text="{Binding Text, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontSize="14"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
                                             Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}" />

                                    <!-- Tool Executions Badge Section -->
                                    <ItemsControl ItemsSource="{Binding ToolResults}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:ToolResultItem}">
                                                <Border Background="#161B26"
                                                        BorderBrush="{StaticResource BorderDarkBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12,8"
                                                        Margin="0,4">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🔧 Tool:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0" />
                                                            <TextBlock Text="{Binding ToolName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,8,0" />
                                                            <Border Background="{Binding RiskTier, Converter={StaticResource RiskToColor}}" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding RiskTier}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            </Border>
                                                            <TextBlock Text="✓ Success" FontSize="11" Foreground="{StaticResource AccentEmeraldBrush}"
                                                                       Visibility="{Binding Success, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Text="✗ Failed" FontSize="11" Foreground="#EF4444"
                                                                       Visibility="{Binding Success, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Output}"
                                                                   FontFamily="Consolas, Courier New, monospace"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Error Banner -->
                                    <Border Background="#2B1518"
                                            BorderBrush="#EF4444"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding Error, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding Error, StringFormat='⚠️ Error: {0}'}"
                                                   Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Global Error Notification Banner -->
        <Border Grid.Row="2"
                Background="#2B1518"
                BorderBrush="#EF4444"
                BorderThickness="0,1,0,0"
                Padding="16,8"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage, StringFormat='⚠️ {0}'}"
                       Foreground="#FCA5A5"
                       FontSize="13"
                       FontWeight="SemiBold" />
        </Border>

        <!-- Bottom Input Bar -->
        <Border Grid.Row="3"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Input Box with Watermark Overlay -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <TextBox x:Name="InputBox"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="InputBox_PreviewKeyDown"
                             AcceptsReturn="True"
                             MaxHeight="120"
                             MinHeight="46"
                             VerticalScrollBarVisibility="Auto"
                             Padding="14,11"
                             FontSize="14" />
                    <!-- Watermark -->
                    <TextBlock Text="Ask SON anything or give a command (e.g. 'open chrome', 'weather in Tokyo')... Enter to send, Shift+Enter for newline"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13"
                               Padding="16,13"
                               IsHitTestVisible="False"
                               Visibility="{Binding InputText, Converter={StaticResource NullToVisibility}}" />
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Command="{Binding SendMessageCommand}"
                            Content="Send  ➤"
                            Padding="22,12"
                            Height="46"
                            FontSize="14"
                            FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
