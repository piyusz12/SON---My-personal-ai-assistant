<UserControl x:Class="SON.Desktop.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:SON.Desktop.Models"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- TOP CONVERSATION BAR (FROSTED GLASS HEADER)                -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource GlassSurfaceBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeometryChat}" Width="16" Height="16" Fill="{StaticResource AccentCyanBrush}" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="AI Conversation" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Background="#1E2A4080"
                            BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="PydanticAI Defensive Pipeline"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentCyanBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding StopGenerationCommand}"
                            Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource DangerButton}"
                            Content="Stop"
                            Padding="14,6"
                            FontSize="12"
                            Margin="0,0,8,0" />
                    <Button Command="{Binding ClearChatCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Content="Clear Chat"
                            Padding="14,6"
                            FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- MESSAGES SCROLL AREA (APPLE CHAT BUBBLES)                  -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      x:Name="MessagesScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,18">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ChatMessage}">
                        <Grid Margin="0,10">
                            <!-- ── USER MESSAGE BUBBLE (APPLE SAPPHIRE GRADIENT) ── -->
                            <Border HorizontalAlignment="Right"
                                    MaxWidth="720"
                                    Background="{StaticResource AppleUserBubbleBrush}"
                                    BorderBrush="#50FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="18,18,4,18"
                                    Padding="18,13"
                                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Color="#1D4ED8" Opacity="0.35" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding FormattedTime}"
                                               FontSize="10"
                                               Foreground="#C7D2FE"
                                               HorizontalAlignment="Right"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- ── ASSISTANT MESSAGE BUBBLE (APPLE FROSTED OBSIDIAN GLASS) ── -->
                            <Border HorizontalAlignment="Left"
                                    MaxWidth="800"
                                    Style="{StaticResource GlassCard}"
                                    CornerRadius="18,18,18,4"
                                    Padding="20,16"
                                    Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <!-- Assistant Header with Neon Avatar Pill & Copy Button -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Glowing SON AI Badge -->
                                            <Border Background="#00F0FF1C"
                                                    BorderBrush="#00F0FF66"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="7,2"
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,5,0">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#00F0FF" Opacity="0.8" />
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <TextBlock Text="SON AI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{Binding FormattedTime}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Copy to Clipboard Button -->
                                        <Button Grid.Column="2"
                                                Command="{Binding DataContext.CopyMessageTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Text}"
                                                ToolTip="Copy response to clipboard"
                                                Background="Transparent"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Padding="6,2"
                                                FontSize="11"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Copy" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Loading / Streaming Indicator (Neon Glow Bar) -->
                                    <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                                Orientation="Horizontal" Margin="0,8">
                                        <ProgressBar IsIndeterminate="True" Width="130" Height="4"
                                                     Foreground="{StaticResource AccentCyanBrush}"
                                                     Background="#131D33" BorderThickness="0" Margin="0,0,12,0">
                                            <ProgressBar.Clip>
                                                <RectangleGeometry Rect="0,0,130,4" RadiusX="2" RadiusY="2" />
                                            </ProgressBar.Clip>
                                        </ProgressBar>
                                        <TextBlock Text="Synthesizing response through local model..."
                                                   FontSize="12" Foreground="{StaticResource AccentCyanBrush}" FontStyle="Italic" />
                                    </StackPanel>

                                    <!-- Assistant Body (Selectable Text) -->
                                    <TextBox Text="{Binding Text, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontSize="14"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                             Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}" />

                                    <!-- Tool Results Badges (Apple Glass Capsules) -->
                                    <ItemsControl ItemsSource="{Binding ToolResults}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:ToolResultItem}">
                                                <Border Background="#121826CC"
                                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="12,9"
                                                        Margin="0,4">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Tool:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,5,0" />
                                                            <TextBlock Text="{Binding ToolName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0" />
                                                            <Border Background="{Binding RiskTier, Converter={StaticResource RiskToColor}}" CornerRadius="4" Padding="6,1.5" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding RiskTier}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            </Border>
                                                            <TextBlock Text="Success" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentEmeraldBrush}"
                                                                       Visibility="{Binding Success, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Text="Failed" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444"
                                                                       Visibility="{Binding Success, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        </StackPanel>
                                                        <Border Background="#090E17B3"
                                                                CornerRadius="6"
                                                                Padding="8,6"
                                                                Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding Output}"
                                                                       FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Error Banner -->
                                    <Border Background="#2B1518CC"
                                            BorderBrush="#EF4444"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,8"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding Error, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding Error, StringFormat='{}Error: {0}'}"
                                                   Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- GLOBAL ERROR BANNER                                        -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#2B1518CC"
                BorderBrush="#EF4444"
                BorderThickness="0,1,0,0"
                Padding="16,8"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#FCA5A5"
                       FontSize="12.5"
                       FontWeight="SemiBold" />
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- FLOATING APPLE GLASS INPUT DOCK                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{StaticResource GlassSurfaceBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <!-- Floating Capsule Dock -->
            <Border Background="#121826CC"
                    BorderBrush="{StaticResource GlassBorderHighlightBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="6,4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.4" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Input Box with Watermark -->
                    <Grid Grid.Column="0" Margin="10,0,8,0">
                        <TextBox x:Name="InputBox"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="InputBox_PreviewKeyDown"
                                 AcceptsReturn="True"
                                 MaxHeight="120"
                                 MinHeight="40"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="6,10"
                                 FontSize="14" />
                        <!-- Apple-style subtle Watermark -->
                        <TextBlock Text="Ask SON anything or give a command... Press Enter to send"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="13.5"
                                   Padding="6,10"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding InputText, Converter={StaticResource NullToVisibility}}" />
                    </Grid>

                    <!-- Apple Pill Send Button -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,2,0">
                        <Button Command="{Binding SendMessageCommand}"
                                Style="{StaticResource AppleSendButton}"
                                Height="38"
                                Padding="18,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Send" FontSize="13" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <Path Data="{StaticResource GeometryCheck}" Width="12" Height="12" Fill="#020B14" Stretch="Uniform" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
