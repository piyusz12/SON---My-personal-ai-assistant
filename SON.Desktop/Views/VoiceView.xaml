<UserControl x:Class="SON.Desktop.Views.VoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            <!-- Header Card -->
            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="28,24"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Voice Interaction" FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="Local Speech-to-Text (Faster-Whisper) &amp; Neural TTS (Piper ONNX)"
                                   FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#1A2433"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="14,6"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding BackendStatus, StringFormat='Backend: {0}'}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBlueBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Recording Stage Card -->
            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="32,44"
                    Margin="0,0,0,24">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Mic Visual Ring with Dynamic Border and Background -->
                    <Border Width="116" Height="116"
                            CornerRadius="58"
                            Margin="0,0,0,22">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#161B26" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                <Setter Property="BorderThickness" Value="3" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Background" Value="#2B1518" />
                                        <Setter Property="BorderBrush" Value="#EF4444" />
                                        <Setter Property="BorderThickness" Value="4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="🎙️" FontSize="46" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Recording Status -->
                    <TextBlock Text="{Binding VoiceStatus}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />

                    <!-- Live Audio Wave Indicator when Recording -->
                    <ProgressBar IsIndeterminate="True"
                                 Width="180" Height="4"
                                 Foreground="#EF4444"
                                 Background="#1A1F2C"
                                 BorderThickness="0"
                                 Margin="0,0,0,24"
                                 Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Toggle Button -->
                    <Button Command="{Binding ToggleRecordingCommand}"
                            Padding="32,14"
                            FontSize="15"
                            FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="▶ Start Recording" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Background" Value="#EF4444" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="Content" Value="⏹ Stop Recording" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Audio Devices & Engines Configuration -->
            <TextBlock Text="AUDIO CONFIGURATION &amp; PIPELINES"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="4,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Input Device Settings -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="Microphone Input Device" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Input Hardware:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <Border Background="#161B26" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedAudioDevice}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Local STT Pipeline:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <Border Background="#161B26" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <TextBlock Text="{Binding SelectedSttEngine}" FontSize="13" Foreground="{StaticResource AccentEmeraldBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- TTS Settings -->
                <Border Grid.Column="2"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="Speech Synthesis (TTS)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="TTS Engine:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <Border Background="#161B26" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedTtsEngine}" FontSize="13" Foreground="{StaticResource AccentBlueBrush}" />
                        </Border>
                        <TextBlock Text="Voice Model Path:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <Border Background="#161B26" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <TextBlock Text="Piper Neural Model (en_US-lessac-medium)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
