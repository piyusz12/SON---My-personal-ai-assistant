<UserControl x:Class="SON.Desktop.Views.VoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- HEADER (APPLE GLASS CARD)                                  -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource GlassCard}"
                    Padding="28,24"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Voice Interaction" FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="Neural Speech-to-Text (Faster-Whisper) &amp; Neural Speech Synthesis (Piper ONNX)"
                                   FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Style="{StaticResource GlassPill}"
                            Padding="14,6"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding BackendStatus, StringFormat='Backend: {0}'}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentCyanBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- RECORDING STAGE (APPLE INTELLIGENCE SIRI ORB AESTHETIC)    -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource GlassCard}"
                    Padding="32,48"
                    Margin="0,0,0,24">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Glowing Apple-style Siri / Voice Orb -->
                    <Border Width="120" Height="120"
                            CornerRadius="60"
                            Margin="0,0,0,24">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#121A2CB3" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentEmeraldBrush}" />
                                <Setter Property="BorderThickness" Value="2.5" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#10B981" Opacity="0.5" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Background" Value="#2E1218CC" />
                                        <Setter Property="BorderBrush" Value="#F43F5E" />
                                        <Setter Property="BorderThickness" Value="3" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="32" ShadowDepth="0" Color="#F43F5E" Opacity="0.75" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Path Data="{StaticResource GeometryVoice}" Width="40" Height="40" Fill="{StaticResource AccentCyanBrush}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Recording Status Typography -->
                    <TextBlock Text="{Binding VoiceStatus}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />

                    <!-- Live Audio Wave Indicator when Recording -->
                    <ProgressBar IsIndeterminate="True"
                                 Width="200" Height="5"
                                 Foreground="#F43F5E"
                                 Background="#1A2436"
                                 BorderThickness="0"
                                 Margin="0,0,0,24"
                                 Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar.Clip>
                            <RectangleGeometry Rect="0,0,200,5" RadiusX="2.5" RadiusY="2.5" />
                        </ProgressBar.Clip>
                    </ProgressBar>

                    <!-- Apple Pill Toggle Button -->
                    <Button Command="{Binding ToggleRecordingCommand}"
                            Padding="36,14"
                            FontSize="14.5"
                            FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="Start Recording" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Background" Value="#E11D48" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="Content" Value="Stop Recording" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- AUDIO CONFIGURATION (APPLE GLASS CARDS)                    -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Input Device Card -->
                <Border Grid.Column="0"
                        Style="{StaticResource GlassCard}"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="AUDIO INPUT DEVICE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="Selected Microphone:" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding InputDevices}"
                                  SelectedItem="{Binding SelectedInputDevice}"
                                  Padding="12,8"
                                  Margin="0,0,0,14" />
                        <TextBlock Text="Default system capture stream active with WebRTC VAD."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>

                <!-- Output Device Card -->
                <Border Grid.Column="2"
                        Style="{StaticResource GlassCard}"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="AUDIO OUTPUT DEVICE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="Selected Speaker / Headset:" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding OutputDevices}"
                                  SelectedItem="{Binding SelectedOutputDevice}"
                                  Padding="12,8"
                                  Margin="0,0,0,14" />
                        <TextBlock Text="Neural Piper ONNX voice model: en_US-lessac-medium."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
