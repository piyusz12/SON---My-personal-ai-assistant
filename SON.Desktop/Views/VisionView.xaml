<UserControl x:Class="SON.Desktop.Views.VisionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="750" d:DesignWidth="920">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            <!-- Header Card -->
            <Border Style="{StaticResource GlassCard}" Padding="28,22" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Vision &amp; Screen Understanding" FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="Hardware-accelerated screen capture with local visual question answering and text OCR."
                                   FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource GlassPill}" Padding="14,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentEmeraldBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding PrivacyBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentEmeraldBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Screen Preview Stage -->
            <Border Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="260" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="LIVE DISPLAY PREVIEW" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ScreenResolutionText}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Real Captured Screen Canvas -->
                    <Border Grid.Row="1" Background="#0A0E17CC" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <!-- Captured Live Image -->
                            <Image Source="{Binding ScreenPreviewImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ScreenPreviewImage, Converter={StaticResource NotNullToVisibility}}" />

                            <!-- Initial Standby Prompt when no screenshot yet taken -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ScreenPreviewImage, Converter={StaticResource NullToVisibility}}">
                                <Path Data="{StaticResource GeometryVision}" Fill="{StaticResource AccentCyanBrush}" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="Click any action below to capture your display" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Captured strictly in local system RAM. Never uploaded." FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Analysis Loading Overlay -->
                            <Border Background="#0D121DE6" CornerRadius="12" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" Width="160" Height="4" Foreground="{StaticResource AccentCyanBrush}" Background="#162032" BorderThickness="0" Margin="0,0,0,14" />
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- One-Click Visual Action Triggers -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding CaptureAndAnalyzeCommand}" CommandParameter="Explain" Style="{StaticResource SecondaryButton}" Height="44" Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeometrySearch}" Width="12" Height="12" Fill="{StaticResource AccentCyanBrush}" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Explain Screen" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Command="{Binding CaptureAndAnalyzeCommand}" CommandParameter="Error" Style="{StaticResource SecondaryButton}" Height="44" Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeometrySecurity}" Width="12" Height="12" Fill="{StaticResource AccentAmberBrush}" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Find Errors" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="4" Command="{Binding CaptureAndAnalyzeCommand}" CommandParameter="OCR" Style="{StaticResource SecondaryButton}" Height="44" Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeometryFiles}" Width="12" Height="12" Fill="{StaticResource AccentBlueBrush}" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Transcribe Text" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="6" Command="{Binding CaptureAndAnalyzeCommand}" CommandParameter="General" Style="{StaticResource SecondaryButton}" Height="44" Padding="10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeometryVision}" Width="12" Height="12" Fill="{StaticResource AccentEmeraldBrush}" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Analyze Context" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Analysis Output Card -->
            <Border Style="{StaticResource GlassCard}" Padding="22" Visibility="{Binding AnalysisResult, Converter={StaticResource NotNullToVisibility}}">
                <StackPanel>
                    <TextBlock Text="AI VISION INSIGHTS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />
                    <Border Background="#090E17CC" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                        <TextBlock Text="{Binding AnalysisResult}" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
