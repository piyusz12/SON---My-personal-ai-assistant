<UserControl x:Class="SON.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            <!-- Welcome Header -->
            <Border Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28,24"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Welcome back, Dad"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="SON V3 Desktop is ready. Local AI inference, zero-trust security, and system tools are active."
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <!-- Backend status pill -->
                    <Border Grid.Column="1"
                            Background="#1A2433"
                            BorderBrush="{StaticResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="14,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding IsConnected, Converter={StaticResource ConnectionToBrush}}"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ConnectionStatus}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Hardware & Model Telemetry Section -->
            <TextBlock Text="HARDWARE TELEMETRY &amp; MODEL RUNTIME"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="4,0,0,12" />

            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="CPU LOAD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding CpuPercent, StringFormat='{}{0}%'}"
                                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,4" />
                        <ProgressBar Value="{Binding CpuPercent}" Maximum="100" Height="4"
                                     Foreground="{StaticResource AccentEmeraldBrush}" Background="#1A1F2C" BorderThickness="0" Margin="0,4,0,4" />
                        <TextBlock Text="AMD Ryzen 7 7840HS" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="2"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="RAM USAGE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding RamPercent, StringFormat='{}{0}%'}"
                                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,6,0,4" />
                        <ProgressBar Value="{Binding RamPercent}" Maximum="100" Height="4"
                                     Foreground="{StaticResource AccentBlueBrush}" Background="#1A1F2C" BorderThickness="0" Margin="0,4,0,4" />
                        <TextBlock Text="{Binding RamUsageText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Grid.Column="4"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="GPU LOAD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding GpuPercent, StringFormat='{}{0}%'}"
                                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,6,0,4" />
                        <ProgressBar Value="{Binding GpuPercent}" Maximum="100" Height="4"
                                     Foreground="{StaticResource AccentEmeraldBrush}" Background="#1A1F2C" BorderThickness="0" Margin="0,4,0,4" />
                        <TextBlock Text="RTX 4060 Laptop (8GB)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- VRAM Card -->
                <Border Grid.Column="6"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="ACTIVE MODEL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ActiveModel}"
                                   FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,8,0,6" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Ollama Local Inference" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding VramUsageText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Access Actions Grid -->
            <TextBlock Text="QUICK ACTIONS"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="4,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Start Chat Button Card -->
                <Button Grid.Column="0" Command="{Binding NavigateToChatCommand}" Style="{StaticResource SecondaryButton}" Height="100">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="💬" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Start Chat" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Converse with SON" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Voice Assistant Button Card -->
                <Button Grid.Column="2" Command="{Binding NavigateToVoiceCommand}" Style="{StaticResource SecondaryButton}" Height="100">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🎙️" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Voice Mode" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Speech to Text" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Memory Explorer Button Card -->
                <Button Grid.Column="4" Command="{Binding NavigateToMemoryCommand}" Style="{StaticResource SecondaryButton}" Height="100">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🧠" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Memory" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Structured Facts" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Security & Approvals Button Card -->
                <Button Grid.Column="6" Command="{Binding NavigateToSecurityCommand}" Style="{StaticResource SecondaryButton}" Height="100">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Security &amp; Approvals" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Authorization Policy" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

