<UserControl x:Class="SON.Desktop.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:SON.Desktop.Models"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <Grid Background="Transparent" Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- HEADER (APPLE GLASS CARD)                                  -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Style="{StaticResource GlassCard}"
                Padding="28,22"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Security &amp; Authorization Gateway" FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="Zero-trust enforcement, human-in-the-loop approvals, and tamper-resistant audit trail."
                               FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RefreshSecurityDataCommand}" Style="{StaticResource SecondaryButton}" Content="Refresh Security" VerticalAlignment="Center" Padding="14,7" />
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- SECURITY COMPONENTS STATUS ROW (APPLE GLASS TILES)         -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- PolicyEngine Card -->
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="SECURITY POLICY ENGINE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding PolicyEngineStatus}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- ApprovalManager Card -->
            <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="APPROVAL MANAGER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ApprovalManagerStatus}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- AuditLogger Card -->
            <Border Grid.Column="4" Style="{StaticResource GlassCard}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="AUDIT LOGGER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding AuditLoggerStatus}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT: PENDING APPROVALS & LIVE AUDIT TRAIL         -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Pending Approvals Inbox (Apple Glass Card) -->
            <Border Grid.Column="0"
                    Style="{StaticResource GlassCard}"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="PENDING ACTION APPROVALS (DAD'S INBOX)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="Sensitive actions paused until explicitly approved."
                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Empty state when 0 approvals pending -->
                    <Border Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding PendingApprovals.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=0, Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource GeometrySecurity}" Width="36" Height="36" Fill="{StaticResource TextMutedBrush}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="No Pending Approvals" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Zero sensitive actions currently require authorization." FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Approvals List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding PendingApprovals}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ApprovalItem}">
                                <Border Background="#121826CC"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="16,14"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Tool: " FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding ToolName}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                                <Border Background="{Binding RiskLevel, Converter={StaticResource RiskToColor}}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding RiskLevel}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ApprovalId}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock Text="Arguments:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                        <Border Background="#090E17B3" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding ArgumentsSummary}" FontFamily="Consolas, Cascadia Code, monospace" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </Border>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Command="{Binding DataContext.ApproveActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding ApprovalId}"
                                                    Content="Approve"
                                                    Padding="16,7"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Margin="0,0,8,0" />
                                            <Button Command="{Binding DataContext.DenyActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding ApprovalId}"
                                                    Style="{StaticResource DangerButton}"
                                                    Content="Deny"
                                                    Padding="16,7"
                                                    FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Live Audit Log Stream (Apple Glass Card) -->
            <Border Grid.Column="2"
                    Style="{StaticResource GlassCard}"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RECENT SECURITY AUDIT EVENTS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding RecentAuditEvents}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#121826B3"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,0,0,6">
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                                               FontSize="11"
                                               Foreground="{Binding Converter={StaticResource AuditEventColor}}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Message -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="4,12,0,0" />
    </Grid>
</UserControl>
