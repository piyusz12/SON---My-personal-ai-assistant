<Window x:Class="SON.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:SON.Desktop.Services"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1320" Height="860"
        MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Branding (Draggable window top) -->
                <Border Grid.Row="0" Padding="20,20,20,18" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="{StaticResource AccentEmeraldBrush}"
                                    CornerRadius="8"
                                    Width="34" Height="34"
                                    Margin="0,0,12,0">
                                <TextBlock Text="S"
                                           FontSize="20"
                                           FontWeight="Black"
                                           Foreground="#0A0C10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SON DESKTOP"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="AI Operating Node"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentEmeraldBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <!-- Navigation Links with Active Indicator -->
                <StackPanel Grid.Row="1" Margin="10,4">
                    <!-- Dashboard / Home Button -->
                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static services:NavigationPage.Home}"
                            ToolTip="Hardware telemetry, active model, and system status"
                            Margin="0,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="navBorder"
                                        Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Home}"
                                        CornerRadius="8"
                                        Padding="10,10"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="{StaticResource AccentEmeraldBrush}"
                                                CornerRadius="2"
                                                Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Home}" />
                                        <TextBlock Grid.Column="2" Text="🏠" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="Dashboard"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Home}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" TargetName="navBorder" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Chat Button -->
                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static services:NavigationPage.Chat}"
                            ToolTip="AI conversation powered by PydanticAI defensive agent"
                            Margin="0,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="navBorder"
                                        Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Chat}"
                                        CornerRadius="8"
                                        Padding="10,10"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="{StaticResource AccentEmeraldBrush}"
                                                CornerRadius="2"
                                                Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Chat}" />
                                        <TextBlock Grid.Column="2" Text="💬" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="Chat"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Chat}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" TargetName="navBorder" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Voice Button -->
                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static services:NavigationPage.Voice}"
                            ToolTip="Voice control with Whisper STT &amp; Piper TTS"
                            Margin="0,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="navBorder"
                                        Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Voice}"
                                        CornerRadius="8"
                                        Padding="10,10"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="{StaticResource AccentEmeraldBrush}"
                                                CornerRadius="2"
                                                Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Voice}" />
                                        <TextBlock Grid.Column="2" Text="🎙️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="Voice"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Voice}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" TargetName="navBorder" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Memory Button -->
                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static services:NavigationPage.Memory}"
                            ToolTip="Long-term structured facts &amp; SQLite knowledge store"
                            Margin="0,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="navBorder"
                                        Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Memory}"
                                        CornerRadius="8"
                                        Padding="10,10"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="{StaticResource AccentEmeraldBrush}"
                                                CornerRadius="2"
                                                Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Memory}" />
                                        <TextBlock Grid.Column="2" Text="🧠" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="Memory"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Memory}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" TargetName="navBorder" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Security & Approvals Button -->
                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static services:NavigationPage.Security}"
                            ToolTip="Zero-trust policy gates, pending approvals &amp; audit trail"
                            Margin="0,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="navBorder"
                                        Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Security}"
                                        CornerRadius="8"
                                        Padding="10,10"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="{StaticResource AccentEmeraldBrush}"
                                                CornerRadius="2"
                                                Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Security}" />
                                        <TextBlock Grid.Column="2" Text="🛡️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="Security &amp; Approvals"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Security}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" TargetName="navBorder" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Settings Button -->
                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static services:NavigationPage.Settings}"
                            ToolTip="Model selection, Named Pipe IPC, and system preferences"
                            Margin="0,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="navBorder"
                                        Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Settings}"
                                        CornerRadius="8"
                                        Padding="10,10"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="{StaticResource AccentEmeraldBrush}"
                                                CornerRadius="2"
                                                Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Settings}" />
                                        <TextBlock Grid.Column="2" Text="⚙️" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="Settings"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Settings}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" TargetName="navBorder" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Current User Badge (Bottom) -->
                <Border Grid.Row="2"
                        Background="#161B26"
                        BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="#232A3B"
                                CornerRadius="18"
                                Width="36" Height="36"
                                Margin="0,0,10,0">
                            <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Dad" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Primary Approver (Admin)" FontSize="10" Foreground="{StaticResource AccentEmeraldBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right Main Stage -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar (Draggable) -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SON DESKTOP" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="— Native Windows AI Assistant" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Header Status, Reconnect & Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Connection Status Pill -->
                        <Border Background="#161B26"
                                BorderBrush="{StaticResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,5"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7"
                                         Fill="{Binding IsConnected, Converter={StaticResource ConnectionToBrush}}"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ConnectionStatus}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding ReconnectBackendCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Content="🔄 Reconnect"
                                Padding="10,5"
                                FontSize="12"
                                Margin="0,0,16,0"
                                WindowChrome.IsHitTestVisibleInChrome="True" />

                        <!-- Custom Window Chrome Buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Click="MinimizeButton_Click"
                                    Width="32" Height="30"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="14"
                                    Padding="0"
                                    Margin="2,0"
                                    ToolTip="Minimize">
                                <TextBlock Text="—" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                            <Button Click="MaximizeButton_Click"
                                    Width="32" Height="30"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="12"
                                    Padding="0"
                                    Margin="2,0"
                                    ToolTip="Maximize / Restore">
                                <TextBlock Text="▢" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                            <Button Click="CloseButton_Click"
                                    Width="32" Height="30"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="13"
                                    Padding="0"
                                    Margin="2,0"
                                    ToolTip="Close">
                                <TextBlock Text="✕" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active View Presentation Area -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Model: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveModel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <TextBlock Text="Zero-Trust Pipeline: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="ENFORCED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
