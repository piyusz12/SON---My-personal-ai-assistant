                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SYSTEM: " FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Model: " FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Border Background="#1E2A4080" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7,2" Margin="0,0,12,0">
                                <TextBlock Text="{Binding ActiveModel}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="Zero-Trust Gates: " FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Border Background="#00F0FF1A" BorderBrush="#00F0FF55" BorderThickness="1" CornerRadius="8" Padding="7,2">
                                <TextBlock Text="ACTIVE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════ -->
        <!-- COMMAND PALETTE MODAL OVERLAY (Ctrl+K)                           -->
        <!-- ════════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="1000">
            <!-- Dimmed Backdrop (Click to dismiss) -->
            <Border Background="#A0000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseCommandPaletteCommand}" />
                </Border.InputBindings>
            </Border>

            <!-- Centered Glass Modal Dialog -->
            <Border Width="620" MaxHeight="520" VerticalAlignment="Top" Margin="0,90,0,0"
                    Background="#111827FA"
                    BorderBrush="{StaticResource GlassBorderHighlightBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="48" ShadowDepth="16" Direction="270" Color="#000000" Opacity="0.85" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Search Input Bar -->
                    <Grid Grid.Row="0" Margin="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource GeometrySearch}" Width="16" Height="16" Fill="{StaticResource AccentCyanBrush}" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding CommandPaletteSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="15"
                                 FontWeight="Medium"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentCyanBrush}"
                                 VerticalAlignment="Center" />
                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="ESC to exit" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                    </Grid>

                    <!-- Divider -->
                    <Border Grid.Row="1" Background="{StaticResource GlassBorderBrush}" />

                    <!-- Search Results -->
                    <ScrollViewer Grid.Row="2" MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,8">
                        <ItemsControl ItemsSource="{Binding FilteredCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ExecuteCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,9"
                                            Margin="0,2"
                                            HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Vector Icon -->
                                            <Border Grid.Column="0" Background="#1C273B" CornerRadius="8" Width="30" Height="30" Margin="0,0,12,0">
                                                <Path Data="{Binding IconKey, Converter={StaticResource ResourceKeyToGeometry}}"
                                                      Width="14" Height="14"
                                                      Fill="{StaticResource AccentCyanBrush}"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Title & Subtitle -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Category Badge -->
                                            <Border Grid.Column="2" Background="#122538" BorderBrush="#1C3857" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                                            </Border>

                                            <!-- Keyboard Shortcut Badge -->
                                            <Border Grid.Column="3" Background="#1E293B" CornerRadius="6" Padding="7,3" VerticalAlignment="Center"
                                                    Visibility="{Binding Shortcut, Converter={StaticResource NotNullToVisibility}}">
                                                <TextBlock Text="{Binding Shortcut}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer Tip -->
                    <Border Grid.Row="3" Background="#0A0E17" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10" CornerRadius="0,0,16,16">
                        <Grid>
                            <TextBlock Text="Navigate with keyboard or click to execute" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="SON Operating Layer" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════ -->
        <!-- PRIVACY VERIFICATION POPOVER                                     -->
        <!-- ════════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsPrivacyPopupOpen, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="1001">
            <!-- Dimmed Backdrop -->
            <Border Background="#66000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding TogglePrivacyPopupCommand}" />
                </Border.InputBindings>
            </Border>

            <!-- Verification Card -->
            <Border Width="460" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,58,40,0"
                    Background="#101827FA"
                    BorderBrush="{StaticResource GlassBorderHighlightBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.8" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#10B98126" BorderBrush="{StaticResource AccentEmeraldBrush}" BorderThickness="1" CornerRadius="10" Width="32" Height="32" Margin="0,0,10,0">
                                <Path Data="{StaticResource GeometrySecurity}" Width="15" Height="15" Fill="{StaticResource AccentEmeraldBrush}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Zero-Trust Privacy Verified" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="100% Local PC Processing Guarantee" FontSize="11" Foreground="{StaticResource AccentEmeraldBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding TogglePrivacyPopupCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand">
                            <Path Data="{StaticResource GeometryClose}" Width="12" Height="12" Fill="{StaticResource TextMutedBrush}" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <Border Height="1" Background="{StaticResource GlassBorderBrush}" Margin="0,0,0,14" />

                    <!-- Verification Checklist -->
                    <StackPanel Margin="0,0,0,16">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource GeometryCheck}" Width="12" Height="12" Fill="{StaticResource AccentEmeraldBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Local Ollama AI Inference (Zero external telemetry)" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" />
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource GeometryCheck}" Width="12" Height="12" Fill="{StaticResource AccentEmeraldBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Windows Named Pipe IPC (Encrypted local process)" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" />
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource GeometryCheck}" Width="12" Height="12" Fill="{StaticResource AccentEmeraldBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Defensive PydanticAI Architecture (Prompt injection immune)" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" />
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource GeometryCheck}" Width="12" Height="12" Fill="{StaticResource AccentEmeraldBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Human-in-the-Loop Gateway (Shell/Filesystem access gated)" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" />
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource GeometryCheck}" Width="12" Height="12" Fill="{StaticResource AccentEmeraldBrush}" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Local SQLite Knowledge Store (Private to this PC)" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Command="{Binding TogglePrivacyPopupCommand}" Style="{StaticResource SecondaryButton}" Content="Got It" HorizontalAlignment="Right" Padding="18,6" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>