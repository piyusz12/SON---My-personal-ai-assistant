<Window x:Class="SON.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:SON.Desktop.Services"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="/Resources/son_icon.ico"
        Width="1340" Height="880"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- DYNAMIC HARDWARE-ACCELERATED LIVING ANIMATION TRIGGERS           -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard x:Name="LivingAuroraBeginStoryboard">
                <Storyboard x:Name="LivingAuroraStoryboard" RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                    <!-- Cyan Orb Organic Floating Drift -->
                    <DoubleAnimation Storyboard.TargetName="CyanOrbTransform"
                                     Storyboard.TargetProperty="X"
                                     From="0" To="140" Duration="0:0:18"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CyanOrbTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="0" To="100" Duration="0:0:23"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Violet Orb Organic Floating Drift -->
                    <DoubleAnimation Storyboard.TargetName="VioletOrbTransform"
                                     Storyboard.TargetProperty="X"
                                     From="0" To="-150" Duration="0:0:26"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="VioletOrbTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="0" To="-110" Duration="0:0:19"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Cobalt Orb Organic Floating Drift -->
                    <DoubleAnimation Storyboard.TargetName="CobaltOrbTransform"
                                     Storyboard.TargetProperty="X"
                                     From="0" To="90" Duration="0:0:15"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CobaltOrbTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="0" To="-80" Duration="0:0:21"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Breathing AI Avatar Shadow Pulse -->
                    <DoubleAnimation Storyboard.TargetName="AvatarShadow"
                                     Storyboard.TargetProperty="BlurRadius"
                                     From="14" To="28" Duration="0:0:3.2"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="AvatarShadow"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.45" To="0.95" Duration="0:0:3.2"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- DYNAMIC LIVING PLASMA AURORA & CYBER HUD CANVAS                  -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <Grid>
        <!-- Deep Cosmic Void Base -->
        <Rectangle Fill="{StaticResource BgDarkBrush}" />

        <!-- Futuristic Cybernetic HUD Grid Matrix -->
        <Rectangle Opacity="0.02" IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,44,44" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="{StaticResource AccentCyanBrush}" Thickness="0.75" />
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="44,0" />
                                        <LineGeometry StartPoint="0,0" EndPoint="0,44" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Dynamic Living Plasma Aurora Orbs (Soft Ambient Luminous Layer) -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <!-- Living Electric Cyan Plasma Orb (Top-Left quadrant) -->
            <Ellipse Width="700" Height="700"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-180,-180,0,0" Opacity="0.14">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#00E5FF" Offset="0.0" />
                        <GradientStop Color="#0099FF" Offset="0.45" />
                        <GradientStop Color="#0006080E" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="CyanOrbTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Living Synth Violet Plasma Orb (Bottom-Right quadrant) -->
            <Ellipse Width="780" Height="780"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-200,-200" Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#A855F7" Offset="0.0" />
                        <GradientStop Color="#6366F1" Offset="0.5" />
                        <GradientStop Color="#0006080E" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="VioletOrbTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Living Deep Sapphire Cobalt Plasma Orb (Center-Top quadrant) -->
            <Ellipse Width="560" Height="560"
                     HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="80,-80,0,0" Opacity="0.10">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#3B82F6" Offset="0.0" />
                        <GradientStop Color="#1D4ED8" Offset="0.55" />
                        <GradientStop Color="#0006080E" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="CobaltOrbTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- Main Window Columns: Collapsible Frosted Sidebar (Auto) | Content Stage (*) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- COLLAPSIBLE FROSTED GLASS SIDEBAR                          -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Width="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToSidebarWidth}}"
                    Background="{StaticResource GlassBaseBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App Branding & Sidebar Toggle Header -->
                    <Border Grid.Row="0" Padding="14,14,14,12" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <StackPanel>
                            <!-- Apple macOS Traffic Lights Row (Close, Minimize, Maximize) -->
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,12" WindowChrome.IsHitTestVisibleInChrome="True">
                                <!-- Close (Red) -->
                                <Button Click="CloseButton_Click" Width="12" Height="12" Margin="0,0,8,0" Cursor="Hand" ToolTip="Close (Alt+F4)" WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="dot" CornerRadius="6" Background="#FF5F56" BorderBrush="#E0443E" BorderThickness="0.5">
                                                <Path x:Name="icon" Data="{StaticResource GeometryClose}" Width="6" Height="6" Fill="#4C0000" Stretch="Uniform" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Visibility" TargetName="icon" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Minimize (Amber) -->
                                <Button Click="MinimizeButton_Click" Width="12" Height="12" Margin="0,0,8,0" Cursor="Hand" ToolTip="Mini Companion Mode (Ctrl+M)" WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="dot" CornerRadius="6" Background="#FFBD2E" BorderBrush="#DEA123" BorderThickness="0.5">
                                                <Path x:Name="icon" Data="{StaticResource GeometryMinimize}" Width="6" Height="6" Fill="#5C3B00" Stretch="Uniform" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Visibility" TargetName="icon" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Maximize (Green) -->
                                <Button Click="MaximizeButton_Click" Width="12" Height="12" Margin="0,0,8,0" Cursor="Hand" ToolTip="Maximize / Restore" WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="dot" CornerRadius="6" Background="#27C93F" BorderBrush="#1AAB29" BorderThickness="0.5">
                                                <Path x:Name="icon" Data="{StaticResource GeometryMaximize}" Width="6" Height="6" Fill="#004D1A" Stretch="Uniform" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Visibility" TargetName="icon" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                            <!-- Glowing Hooded AI Avatar Squircle -->
                            <Border Grid.Column="0"
                                    CornerRadius="10"
                                    Width="36" Height="36"
                                    Margin="0,0,10,0"
                                    BorderBrush="{StaticResource GlassBorderAccentBrush}"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="AvatarShadow" BlurRadius="14" ShadowDepth="0" Color="#00F0FF" Opacity="0.55" />
                                </Border.Effect>
                                <Border.Background>
                                    <ImageBrush ImageSource="/Resources/son_icon.jpg" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>

                            <!-- Brand Title (Visible when expanded) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SON" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text=" OS" FontSize="15" FontWeight="Light" Foreground="{StaticResource AccentCyanBrush}" />
                                </StackPanel>
                                <TextBlock Text="CYBER CORE • V3.0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,1,0,0" />
                            </StackPanel>

                            <!-- Sidebar Collapse / Expand Toggle Button -->
                            <Button Grid.Column="2"
                                    Command="{Binding ToggleSidebarCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6"
                                    Cursor="Hand"
                                    ToolTip="Toggle Sidebar (Ctrl+B)"
                                    VerticalAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <Path Data="{StaticResource GeometrySidebar}"
                                      Width="14" Height="14"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                    <!-- Navigation Links (11 Dedicated Workspaces) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,4">
                        <StackPanel>
                            <!-- 1. Dashboard / Home -->
                            <Button Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static services:NavigationPage.Home}"
                                    ToolTip="Dashboard — Hardware telemetry &amp; command center (Ctrl+1)"
                                    Margin="0,2">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="navBorder"
                                                Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Home}"
                                                CornerRadius="10"
                                                Padding="10,9"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource AccentCyanBrush}" CornerRadius="1.5" Height="16" VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Home}" />
                                                <Path Grid.Column="2" Data="{StaticResource GeometryHome}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Fill="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Home}" />
                                                <TextBlock Grid.Column="3" Text="Dashboard" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Home}"
                                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="navBorder" Value="#1C283F80" />
                                                <Setter Property="BorderBrush" TargetName="navBorder" Value="{StaticResource GlassBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 2. Chat -->
                            <Button Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static services:NavigationPage.Chat}"
                                    ToolTip="AI Chat — Converse with defensive AI agent (Ctrl+2)"
                                    Margin="0,2">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="navBorder"
                                                Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Chat}"
                                                CornerRadius="10"
                                                Padding="10,9"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource AccentCyanBrush}" CornerRadius="1.5" Height="16" VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Chat}" />
                                                <Path Grid.Column="2" Data="{StaticResource GeometryChat}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Fill="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Chat}" />
                                                <TextBlock Grid.Column="3" Text="Chat" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Chat}"
                                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="navBorder" Value="#1C283F80" />
                                                <Setter Property="BorderBrush" TargetName="navBorder" Value="{StaticResource GlassBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 3. Voice -->
                            <Button Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static services:NavigationPage.Voice}"
                                    ToolTip="Voice Mode — Real-time speech recognition &amp; audio orb (Ctrl+3)"
                                    Margin="0,2">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="navBorder"
                                                Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Voice}"
                                                CornerRadius="10"
                                                Padding="10,9"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource AccentCyanBrush}" CornerRadius="1.5" Height="16" VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Voice}" />
                                                <Path Grid.Column="2" Data="{StaticResource GeometryVoice}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Fill="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Voice}" />
                                                <TextBlock Grid.Column="3" Text="Voice" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Voice}"
                                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="navBorder" Value="#1C283F80" />
                                                <Setter Property="BorderBrush" TargetName="navBorder" Value="{StaticResource GlassBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 4. Memory -->
                            <Button Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static services:NavigationPage.Memory}"
                                    ToolTip="Memory — Long-term structured facts &amp; knowledge store (Ctrl+4)"
                                    Margin="0,2">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="navBorder"
                                                Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Memory}"
                                                CornerRadius="10"
                                                Padding="10,9"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource AccentCyanBrush}" CornerRadius="1.5" Height="16" VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Memory}" />
                                                <Path Grid.Column="2" Data="{StaticResource GeometryMemory}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Fill="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Memory}" />
                                                <TextBlock Grid.Column="3" Text="Memory" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Memory}"
                                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="navBorder" Value="#1C283F80" />
                                                <Setter Property="BorderBrush" TargetName="navBorder" Value="{StaticResource GlassBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 5. Vision -->
                            <Button Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static services:NavigationPage.Vision}"
                                    ToolTip="Vision — Screen capture &amp; visual understanding (Ctrl+5)"
                                    Margin="0,2">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="navBorder"
                                                Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Vision}"
                                                CornerRadius="10"
                                                Padding="10,9"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource AccentCyanBrush}" CornerRadius="1.5" Height="16" VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Vision}" />
                                                <Path Grid.Column="2" Data="{StaticResource GeometryVision}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Fill="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Vision}" />
                                                <TextBlock Grid.Column="3" Text="Vision" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Vision}"
                                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="navBorder" Value="#1C283F80" />
                                                <Setter Property="BorderBrush" TargetName="navBorder" Value="{StaticResource GlassBorderBrush}" />
                                            </Trigger>
