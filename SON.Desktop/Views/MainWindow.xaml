                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" TargetName="searchBorder" Value="{StaticResource GlassBorderHighlightBrush}" />
                                            <Setter Property="Background" TargetName="searchBorder" Value="#182338CC" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
