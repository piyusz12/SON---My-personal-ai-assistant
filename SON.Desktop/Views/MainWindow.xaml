<Window x:Class="SON.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:SON.Desktop.Services"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="/Resources/son_icon.ico"
        Width="1340" Height="880"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- ROOT CANVAS WITH APPLE MULTI-LAYER AMBIENT MESH LIGHTING       -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <Grid>
        <!-- Background Ambient Mesh Lighting -->
        <Rectangle Fill="{StaticResource BgDarkBrush}" />
        <Rectangle Fill="{StaticResource AmbientGlowBrush}" Opacity="0.85" />
        <Rectangle Fill="{StaticResource EmeraldGlowBrush}" Opacity="0.55" />

        <!-- Main Window Columns: Frosted Sidebar (250px) | Content Stage (*) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="254" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- LEFT FROSTED GLASS SIDEBAR                                 -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="{StaticResource GlassBaseBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App Branding Header (Draggable) -->
                    <Border Grid.Row="0" Padding="18,18,18,16" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Glowing Hooded AI Avatar Squircle -->
                                <Border CornerRadius="12"
                                        Width="40" Height="40"
                                        Margin="0,0,12,0"
                                        BorderBrush="{StaticResource GlassBorderAccentBrush}"
                                        BorderThickness="1.5">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#10B981" Opacity="0.5" />
                                    </Border.Effect>
                                    <Border.Background>
                                        <ImageBrush ImageSource="/Resources/son_icon.jpg" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="SON"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text=" DESKTOP"
                                                   FontSize="16"
                                                   FontWeight="Light"
                                                   Foreground="{StaticResource AccentCyanBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="Liquid Glass • V3.0"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentEmeraldBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Subtle frosted divider -->
                            <Border Height="1" Background="{StaticResource GlassBorderBrush}" Margin="0,16,0,0" Opacity="0.7" />
                        </StackPanel>
                    </Border>

                    <!-- Navigation Links with Apple Frosted Capsule Styling -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4">
                        <StackPanel>
                            <!-- Dashboard / Home Button -->
                            <Button Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static services:NavigationPage.Home}"
                                    ToolTip="Hardware telemetry, active model, and system status"
                                    Margin="0,3">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="navBorder"
                                                Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Home}"
                                                CornerRadius="10"
                                                Padding="12,11"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Glowing Accent Indicator Pill -->
                                                <Border Grid.Column="0"
                                                        Background="{StaticResource AccentEmeraldBrush}"
                                                        CornerRadius="2"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Home}">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981" Opacity="0.8" />
                                                    </Border.Effect>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="🏠" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="Dashboard"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Home}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="navBorder" Value="#1C283F80" />
                                                <Setter Property="BorderBrush" TargetName="navBorder" Value="{StaticResource GlassBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Chat Button -->
                            <Button Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static services:NavigationPage.Chat}"
                                    ToolTip="AI conversation powered by PydanticAI defensive agent"
                                    Margin="0,3">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="navBorder"
                                                Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Chat}"
                                                CornerRadius="10"
                                                Padding="12,11"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{StaticResource AccentEmeraldBrush}"
                                                        CornerRadius="2"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Chat}">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981" Opacity="0.8" />
                                                    </Border.Effect>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="💬" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="Chat"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Chat}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="navBorder" Value="#1C283F80" />
                                                <Setter Property="BorderBrush" TargetName="navBorder" Value="{StaticResource GlassBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Voice Button -->
                            <Button Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static services:NavigationPage.Voice}"
                                    ToolTip="Voice control with Whisper STT &amp; Piper TTS"
                                    Margin="0,3">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="navBorder"
                                                Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Voice}"
                                                CornerRadius="10"
                                                Padding="12,11"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{StaticResource AccentEmeraldBrush}"
                                                        CornerRadius="2"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Voice}">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981" Opacity="0.8" />
                                                    </Border.Effect>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="🎙️" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="Voice"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Voice}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="navBorder" Value="#1C283F80" />
                                                <Setter Property="BorderBrush" TargetName="navBorder" Value="{StaticResource GlassBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Memory Button -->
                            <Button Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static services:NavigationPage.Memory}"
                                    ToolTip="Long-term structured facts &amp; SQLite knowledge store"
                                    Margin="0,3">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="navBorder"
                                                Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Memory}"
                                                CornerRadius="10"
                                                Padding="12,11"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{StaticResource AccentEmeraldBrush}"
                                                        CornerRadius="2"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Memory}">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981" Opacity="0.8" />
                                                    </Border.Effect>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="🧠" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="Memory"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Memory}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="navBorder" Value="#1C283F80" />
                                                <Setter Property="BorderBrush" TargetName="navBorder" Value="{StaticResource GlassBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Security & Approvals Button -->
                            <Button Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static services:NavigationPage.Security}"
                                    ToolTip="Zero-trust policy gates, pending approvals &amp; audit trail"
                                    Margin="0,3">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="navBorder"
                                                Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Security}"
                                                CornerRadius="10"
                                                Padding="12,11"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{StaticResource AccentEmeraldBrush}"
                                                        CornerRadius="2"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Security}">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981" Opacity="0.8" />
                                                    </Border.Effect>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="🛡️" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="Security"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Security}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="navBorder" Value="#1C283F80" />
                                                <Setter Property="BorderBrush" TargetName="navBorder" Value="{StaticResource GlassBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Settings Button -->
                            <Button Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static services:NavigationPage.Settings}"
                                    ToolTip="Model selection, Named Pipe IPC, and system preferences"
                                    Margin="0,3">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="navBorder"
                                                Background="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavBg}, ConverterParameter=Settings}"
                                                CornerRadius="10"
                                                Padding="12,11"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{StaticResource AccentEmeraldBrush}"
                                                        CornerRadius="2"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToIndicator}, ConverterParameter=Settings}">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981" Opacity="0.8" />
                                                    </Border.Effect>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="⚙️" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="Settings"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding DataContext.ActivePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageToNavFg}, ConverterParameter=Settings}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="navBorder" Value="#1C283F80" />
                                                <Setter Property="BorderBrush" TargetName="navBorder" Value="{StaticResource GlassBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- User Identity Capsule (Bottom) -->
                    <Border Grid.Row="2"
                            Background="#10172680"
                            BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,14">
                        <Border Background="{StaticResource GlassCardBrush}"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="#1C263B"
                                        BorderBrush="{StaticResource GlassBorderAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Width="32" Height="32"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="👤" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Dad" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Primary Admin" FontSize="10" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- RIGHT MAIN STAGE (TRANSLUCENT FROSTED GLASS)               -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Header Bar (Draggable with Apple Traffic Light Aesthetics) -->
                <Border Grid.Row="0"
                        Background="{StaticResource GlassSurfaceBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="24,12"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Header Title with Apple Pill Badge -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SON DESKTOP" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Border Background="#10B98126"
                                    BorderBrush="#10B98166"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="LOCAL ORCHESTRATOR"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentEmeraldBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Header Status, Reconnect & Apple-grade Window Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Connection Status Pill -->
                            <Border Background="{StaticResource GlassPillBrush}"
                                    BorderBrush="{StaticResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="12,5"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{Binding IsConnected, Converter={StaticResource ConnectionToBrush}}"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#10B981" Opacity="0.8" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ConnectionStatus}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Reconnect Glass Button -->
                            <Button Command="{Binding ReconnectBackendCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="🔄 Reconnect"
                                    Padding="12,5"
                                    FontSize="11.5"
                                    Margin="0,0,16,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />

                            <!-- Custom Window Control Buttons (Apple Inspired) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button Click="MinimizeButton_Click"
                                        Width="30" Height="28"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        FontSize="13"
                                        Padding="0"
                                        Margin="1,0"
                                        ToolTip="Minimize">
                                    <TextBlock Text="—" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Button>
                                <Button Click="MaximizeButton_Click"
                                        Width="30" Height="28"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        FontSize="11"
                                        Padding="0"
                                        Margin="1,0"
                                        ToolTip="Maximize / Restore">
                                    <TextBlock Text="▢" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Button>
                                <Button Click="CloseButton_Click"
                                        Width="30" Height="28"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        FontSize="12"
                                        Padding="0"
                                        Margin="1,0"
                                        ToolTip="Close">
                                    <TextBlock Text="✕" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Active View Presentation Area -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />

                <!-- Bottom Status Bar (Apple Frosted Glass Footer) -->
                <Border Grid.Row="2"
                        Background="{StaticResource GlassSurfaceBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="STATUS: " FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Model: " FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Border Background="#1E2A4080"
                                    BorderBrush="{StaticResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="0,0,14,0">
                                <TextBlock Text="{Binding ActiveModel}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="Zero-Trust Policy: " FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Border Background="#10B98126"
                                    BorderBrush="#10B98166"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,2">
                                <TextBlock Text="ENFORCED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
