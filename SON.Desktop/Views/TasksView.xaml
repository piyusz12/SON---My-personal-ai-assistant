<UserControl x:Class="SON.Desktop.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:SON.Desktop.Models"
             mc:Ignorable="d" d:DesignHeight="750" d:DesignWidth="920">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Card with Overall Progress -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="28,22" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding TaskTitle}" FontSize="24" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding TaskGoal}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                    <!-- Progress Bar -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Progress: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                    </StackPanel>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6" Foreground="{StaticResource AccentEmeraldBrush}" Background="#162032" BorderThickness="0" Width="400" HorizontalAlignment="Left">
                        <ProgressBar.Clip>
                            <RectangleGeometry Rect="0,0,400,6" RadiusX="3" RadiusY="3" />
                        </ProgressBar.Clip>
                    </ProgressBar>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource GlassPill}" Padding="14,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentStatus}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Goal Dispatch Input Bar -->
        <Border Grid.Row="1" Background="#101726B3" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,8" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Data="{StaticResource GeometryTasks}" Width="15" Height="15" Fill="{StaticResource AccentCyanBrush}" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />

                <TextBox Grid.Column="1" Text="{Binding NewGoalInput, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ExecuteNewTaskCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="2" Command="{Binding ExecuteNewTaskCommand}" Style="{StaticResource AppleSendButton}" Padding="18,6"
                        IsEnabled="{Binding IsExecuting, Converter={StaticResource InverseBool}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeometryCheck}" Width="12" Height="12" Fill="#051510" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="Dispatch Plan" FontSize="12" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Body: Steps Breakdown & Audit Stream -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Steps List -->
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="AGENT EXECUTION PLAN &amp; PHASES" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                    <!-- Empty state -->
                    <Border Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Steps.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=0}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource GeometryTasks}" Width="36" Height="36" Fill="{StaticResource TextMutedBrush}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="No Active Execution Plan" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Enter an objective above to dispatch an autonomous workflow." FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Steps}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AgentTaskStep}">
                                <Border Background="#121826CC" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#10B981" Width="20" Height="20" CornerRadius="10" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding StepNumber}" FontSize="11" FontWeight="Bold" Foreground="#0A0C10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Duration}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="30,0,0,6" />

                                        <Border Background="#090E17CC" CornerRadius="6" Padding="10,6" Margin="30,4,0,0">
                                            <TextBlock Text="{Binding Output}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource AccentEmeraldBrush}" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Audit Stream -->
            <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="AGENT VERIFICATION TRACE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                    <!-- Empty state -->
                    <Border Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding AuditTrace.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=0}">
                        <TextBlock Text="Verification trace will appear during task execution." FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding AuditTrace}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#101726B3" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Message -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,12,0,0" />
    </Grid>
</UserControl>
