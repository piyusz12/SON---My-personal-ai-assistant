<UserControl x:Class="SON.Desktop.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:SON.Desktop.Models"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Card with Overall Progress -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="28,22" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding TaskTitle}" FontSize="24" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding TaskGoal}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                    <!-- Progress Bar -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Progress: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                    </StackPanel>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6" Foreground="{StaticResource AccentEmeraldBrush}" Background="#162032" BorderThickness="0" Width="400" HorizontalAlignment="Left">
                        <ProgressBar.Clip>
                            <RectangleGeometry Rect="0,0,400,6" RadiusX="3" RadiusY="3" />
                        </ProgressBar.Clip>
                    </ProgressBar>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource GlassPill}" Padding="14,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentStatus}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Main Body: Steps Breakdown & Audit Stream -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Steps List -->
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="AGENT EXECUTION PLAN &amp; PHASES" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Steps}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AgentTaskStep}">
                                <Border Background="#121826CC" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#10B981" Width="20" Height="20" CornerRadius="10" Margin="0,0,10,0">
                                                    <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#0A0C10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Duration}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="30,0,0,6" />

                                        <Border Background="#090E17CC" CornerRadius="6" Padding="10,6" Margin="30,4,0,0">
                                            <TextBlock Text="{Binding Output}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource AccentEmeraldBrush}" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Audit Stream -->
            <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="AGENT VERIFICATION TRACE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding AuditTrace}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#121826B3" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
